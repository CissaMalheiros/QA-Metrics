# Copie para .env e substitua as senhas antes de iniciar.
POSTGRES_USER=qa_metrics
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=qa_metrics
POSTGRES_PORT=5433
DATABASE_URL=postgresql://qa_metrics:troque-esta-senha-local@localhost:5433/qa_metrics
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# Testes usam banco separado, já criado e migrado. Use a mesma senha local.
# TEST_DATABASE_URL=postgresql://qa_metrics:troque-esta-senha-local@localhost:5433/qa_metrics_test
# DEMO_EMAIL e DEMO_PASSWORD são definidos no terminal para executar o seed opcional.

# Demo autom�tica exige DATABASE_URL com banco dedicado terminado em _demo.
DEMO_MODE=false
