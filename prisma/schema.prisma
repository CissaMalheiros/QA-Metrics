generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum CaseOrigin {
  MANUAL
  JUNIT
  GHERKIN
  CSV
}
enum RunSource {
  MANUAL
  JUNIT_IMPORT
}
enum RunStatus {
  DRAFT
  OPEN
  COMPLETED
  CANCELED
}
enum ResultStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  NOT_RUN
}
enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  personalWorkspace Workspace?
  memberships WorkspaceMember[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model Workspace {
  id String @id @default(cuid())
  name String
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  projects Project[]
  auditLogs AuditLog[]
}
model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  userId String
  role String @default("OWNER")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}
model Project {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  clientName String
  description String @default("")
  environment String @default("")
  status ProjectStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  testCases TestCase[]
  runs TestRun[]
  bugs Bug[]
  suites TestSuite[]
  nextCaseNumber Int @default(1)
  environments Environment[]
  releases Release[]
  plans TestPlan[]
  @@index([workspaceId])
}
model TestCase {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalKey String?
  number Int @default(0)
  suiteId String?
  suite TestSuite? @relation(fields: [suiteId, projectId], references: [id, projectId], onDelete: Restrict)
  tags String[] @default([])
  type String @default("FUNCTIONAL")
  state String @default("READY")
  revision Int @default(1)
  updatedBy String?
  searchText String @default("")
  format String @default("STEPS")
  gherkinSource String @default("")
  gherkinOriginalSource String @default("")
  gherkinKey String?
  gherkinLanguage String @default("pt")
  requirementRef String @default("")
  automationRef String @default("")
  @@unique([projectId, gherkinKey])
  title String
  description String @default("")
  preconditions String @default("")
  steps Json @default("[]")
  expectedResult String @default("")
  priority Priority @default(MEDIUM)
  origin CaseOrigin @default(MANUAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results TestResult[]
  revisions TestCaseRevision[]
  planItems TestPlanItem[]
  @@unique([projectId, number])
  @@index([projectId, state, suiteId])
  @@index([tags], type: Gin, map: "TestCase_tags_gin_idx")
  @@unique([projectId, externalKey])
  @@unique([id, projectId])
  @@index([projectId])
}
model TestRun {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  source RunSource @default(MANUAL)
  status RunStatus @default(OPEN)
  importedFileSha256 String?
  creationKey String?
  creationHash String?
  startedAt DateTime? @default(now())
  planId String?
  plan TestPlan? @relation(fields: [planId, projectId], references: [id, projectId], onDelete: Restrict)
  environmentId String?
  environment Environment? @relation(fields: [environmentId, projectId], references: [id, projectId], onDelete: Restrict)
  releaseId String?
  release Release? @relation(fields: [releaseId, projectId], references: [id, projectId], onDelete: Restrict)
  build String @default("")
  responsibleId String?
  scheduledStart DateTime?
  scheduledEnd DateTime?
  notes String @default("")
  entryCriteria String @default("")
  exitCriteria String @default("")
  contextSnapshot Json @default("{}")
  finishedAt DateTime?
  createdAt DateTime @default(now())
  results TestResult[]
  @@unique([projectId, importedFileSha256])
  @@unique([projectId, creationKey])
  @@unique([id, projectId])
  @@index([projectId, createdAt])
}
model TestResult {
  id String @id @default(cuid())
  projectId String
  runId String
  testCaseId String
  run TestRun @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId, projectId], references: [id, projectId], onDelete: Restrict)
  caseTitle String
  position Int @default(0)
  category String @default("")
  caseSnapshot Json
  status ResultStatus @default(NOT_RUN)
  durationMs Int?
  errorMessage String?
  notes String @default("")
  executedAt DateTime?
  actualResult String @default("")
  executorId String?
  executorName String?
  version Int @default(0)
  draft Json?
  events ResultEvent[]
  bugs Bug[]
  @@unique([runId, testCaseId])
  @@unique([id, projectId])
  @@index([projectId])
  @@index([testCaseId])
}

model ResultEvent {
  id String @id @default(cuid())
  resultId String
  projectId String
  result TestResult @relation(fields: [resultId, projectId], references: [id, projectId], onDelete: Cascade)
  version Int
  actorId String?
  actorName String?
  operationId String?
  requestHash String?
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([resultId, version])
  @@unique([resultId, operationId])
}
model Bug {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testResultId String?
  creationKey String?
  creationHash String?
  testResult TestResult? @relation(fields: [testResultId, projectId], references: [id, projectId], onDelete: Restrict)
  title String
  description String @default("")
  stepsToReproduce String @default("")
  severity Priority @default(MEDIUM)
  status BugStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId, status])
  @@index([testResultId])
  @@unique([projectId, creationKey])
}

model AuditLog {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId String
  actorId String
  action String
  subjectId String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@index([workspaceId, projectId, createdAt])
}

model TestSuite {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  parentId String?
  parent TestSuite? @relation("SuiteTree", fields: [parentId, projectId], references: [id, projectId], onDelete: Restrict)
  children TestSuite[] @relation("SuiteTree")
  cases TestCase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, projectId])
  @@index([projectId, parentId])
}

model TestCaseRevision {
  id String @id @default(cuid())
  projectId String
  testCaseId String
  testCase TestCase @relation(fields: [testCaseId, projectId], references: [id, projectId], onDelete: Cascade)
  revision Int
  snapshot Json
  actorId String?
  createdAt DateTime @default(now())
  @@unique([testCaseId, revision])
  @@index([projectId, testCaseId])
}

model Environment {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  baseUrl String @default("")
  archived Boolean @default(false)
  runs TestRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, projectId])
  @@unique([projectId, name])
}

model Release {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  version String
  archived Boolean @default(false)
  runs TestRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, projectId])
  @@unique([projectId, version])
}

model TestPlan {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  description String @default("")
  archived Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items TestPlanItem[]
  runs TestRun[]
  @@unique([id, projectId])
  @@index([projectId, archived])
}

model TestPlanItem {
  id String @id @default(cuid())
  projectId String
  planId String
  plan TestPlan @relation(fields: [planId, projectId], references: [id, projectId], onDelete: Cascade)
  testCaseId String
  testCase TestCase @relation(fields: [testCaseId, projectId], references: [id, projectId], onDelete: Restrict)
  revision Int
  caseSnapshot Json
  position Int
  category String @default("")
  @@unique([planId, testCaseId])
  @@unique([planId, position])
}
